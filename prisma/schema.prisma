// Sqbe HRMS - Prisma Schema for PostgreSQL
// Matches src/types/index.ts field-for-field with application-layer tenant isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. TENANCY & ORGANIZATIONS
// -------------------------------------------------------------

enum OrganizationStatus {
  Active
  Inactive
  Trial
}

enum BillingPlan {
  Enterprise
  Professional
  Growth
}

model Organization {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  industry      String
  employeeCount Int                @default(0)
  activeUsers   Int                @default(0)
  status        OrganizationStatus @default(Active)
  joinedDate    DateTime           @default(now())
  contactEmail  String
  billingPlan   BillingPlan        @default(Enterprise)
  logoUrl       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relationships
  users               User[]
  modules             OrganizationModule[]
  employees           Employee[]
  departments         Department[]
  designations        Designation[]
  shifts              WorkShift[]
  geofences           GeofenceLocation[]
  attendanceRecords   AttendanceRecord[]
  regularizations     RegularizationRequest[]
  leaveRequests       LeaveRequest[]
  salaryStructures    SalaryStructure[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  performanceGoals    PerformanceGoal[]
  performanceReviews PerformanceReview[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  interviews          Interview[]
  notifications       NotificationItem[]
  auditLogs           AuditLogEntry[]
  files               FileMetadata[]
  expenses            ExpenseClaim[]
  announcements       EngagementAnnouncement[]
  recognitions        EngagementRecognition[]
  installedApps       OrganizationMarketplaceApp[]

  @@map("organizations")
}

model OrganizationModule {
  id        String   @id @default(uuid())
  orgId     String
  moduleId  String   // hr, payroll, attendance, performance, recruitment, leave, ess, engagement, marketplace, expense
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleId])
  @@index([orgId])
  @@map("organization_modules")
}

// -------------------------------------------------------------
// 2. USERS & AUTHENTICATION
// -------------------------------------------------------------

enum Role {
  SuperAdmin     @map("Super Admin")
  Admin          @map("Admin")
  OrgAdmin       @map("Org Admin")
  Manager        @map("Manager")
  TeamLead       @map("Team Lead")
  Executive      @map("Executive")
  Employee       @map("Employee")
  HrManager      @map("HR Manager")
  PayrollManager @map("Payroll Manager")
  Recruiter      @map("Recruiter")
}

model User {
  id           String    @id @default(uuid())
  orgId        String?
  email        String    @unique
  passwordHash String
  name         String
  role         String    // Super Admin, Admin, Manager, Team Lead, Executive, etc.
  avatar       String?
  department   String?
  designation  String?
  employeeId   String?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -------------------------------------------------------------
// 3. HR CORE: EMPLOYEES, DEPARTMENTS, DESIGNATIONS, SHIFTS
// -------------------------------------------------------------

model Employee {
  id               String   @id @default(uuid())
  orgId            String
  employeeCode     String
  firstName        String
  lastName         String
  avatar           String?
  email            String
  phone            String
  dob              String?
  gender           String?  // Male, Female, Non-Binary, Prefer not to say
  address          String?
  emergencyContact Json?    // { name: string, relationship: string, phone: string }
  department       String
  designation      String
  managerId        String?
  managerName      String?
  reportingManager String?
  employmentType   String   @default("Full-Time") // Full-Time, Part-Time, Contract, Intern
  joiningDate      String
  workLocation     String?
  location         String?
  status           String   @default("Active") // Active, On Leave, Notice Period, Terminated, Probation
  annualCtc        Float    @default(0.0)
  monthlyGross     Float?
  bankDetails      Json?    // { bankName: string, maskedAccountNumber: string, ifscCode: string }
  documents        Json?    // DocumentItem[]
  lifecycleHistory Json?    // LifecycleEvent[]
  shiftId          String?
  performanceRating Float?  @default(4.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?
  shift        WorkShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([orgId, employeeCode])
  @@unique([orgId, email])
  @@index([orgId])
  @@index([department])
  @@map("employees")
}

model Department {
  id             String   @id @default(uuid())
  orgId          String
  name           String
  code           String
  headEmployeeId String?
  headName       String?
  employeeCount  Int      @default(0)
  budgetInr      Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId])
  @@map("departments")
}

model Designation {
  id                 String   @id @default(uuid())
  orgId              String
  title              String
  department         String
  level              String
  minExperienceYears Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("designations")
}

model WorkShift {
  id                   String   @id @default(uuid())
  orgId                String
  name                 String
  startTime            String   // "09:00"
  endTime              String   // "18:00"
  graceMinutes         Int      @default(15)
  breakDurationMinutes Int      @default(60)
  workingDays          Json     // string[] ["Monday", "Tuesday", ...]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([orgId])
  @@map("work_shifts")
}

// -------------------------------------------------------------
// 4. ATTENDANCE & GEOFENCING
// -------------------------------------------------------------

model GeofenceLocation {
  id              String   @id @default(uuid())
  orgId           String
  name            String
  address         String?
  latitude        Float
  longitude       Float
  radiusMeters    Int      @default(200)
  policy          String   @default("Allow with Warning") // Block, Allow with Warning, Allow with Approval Required, Strict Block
  isRemoteAllowed Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("geofence_locations")
}

model AttendanceRecord {
  id                String   @id @default(uuid())
  orgId             String
  employeeId        String
  employeeName      String
  department        String
  date              String   // "YYYY-MM-DD"
  clockInTime       String?  // "HH:MM:SS"
  clockOutTime      String?  // "HH:MM:SS"
  workHours         Float?   @default(0.0)
  totalWorkingHours Float?   @default(0.0)
  overtimeHours     Float?   @default(0.0)
  status            String   @default("Present") // Present, Late, Half Day, Absent, On Leave
  geofenceStatus    String?  // In Office Geofence, Remote Verified, Warning Distance
  breakMinutes      Int?     @default(0)
  punchLocation     Json?    // Detailed geofence telemetry object
  withinGeofence    Boolean  @default(true)
  distanceMeters    Float?   @default(0.0)
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, employeeId, date])
  @@index([orgId])
  @@index([date])
  @@map("attendance_records")
}

model RegularizationRequest {
  id               String   @id @default(uuid())
  orgId            String
  employeeId       String
  employeeName     String
  date             String
  reason           String
  requestedClockIn String?
  requestedClockOut String?
  status           String   @default("Pending") // Pending, Approved, Rejected
  approverRole     String?  // Manager, Team Lead, HR Manager, Admin
  approverName     String?
  comment          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("regularization_requests")
}

// -------------------------------------------------------------
// 5. LEAVE MANAGEMENT
// -------------------------------------------------------------

model LeaveRequest {
  id                     String   @id @default(uuid())
  orgId                  String
  employeeId             String
  employeeName           String
  employeeAvatar         String?
  department             String
  leaveType              String   // Earned Leave (EL), Casual Leave (CL), Sick Leave (SL), Maternity / Paternity, Comp Off
  startDate              String
  endDate                String
  days                   Float    @default(1.0)
  reason                 String
  appliedDate            String
  status                 String   @default("Pending") // Pending, Approved, Rejected
  approverName           String?
  approverRole           String?
  approvedOrRejectedDate String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("leave_requests")
}

// -------------------------------------------------------------
// 6. PAYROLL & COMPENSATION (STATUTORY VERSIONING)
// -------------------------------------------------------------

model SalaryStructure {
  id                         String   @id @default(uuid())
  orgId                      String
  name                       String
  description                String?
  basicPercentage            Float    @default(40.0)
  hraPercentage              Float    @default(20.0)
  specialAllowancePercentage Float    @default(30.0)
  conveyanceFixed            Float    @default(1600.0)
  medicalAllowanceFixed      Float    @default(1250.0)
  pfRate                     Float    @default(12.0)
  esiRate                    Float    @default(0.75)
  professionalTaxFixed       Float    @default(200.0)
  isDefault                  Boolean  @default(true)
  effectiveFrom              DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("salary_structures")
}

model PayrollRun {
  id                 String   @id @default(uuid())
  orgId              String
  monthYear          String   // "2026-08" or "August 2026"
  status             String   @default("Draft") // Draft, Calculating, Calculated, Review, Approved, Disbursed
  totalEmployees     Int      @default(0)
  processedEmployees Int      @default(0)
  totalGrossPay      Float    @default(0.0)
  totalDeductions    Float    @default(0.0)
  totalTaxes         Float    @default(0.0)
  totalNetPay        Float    @default(0.0)
  processedDate      String?
  approvedBy         String?
  currentStep        Int      @default(1)
  disclaimer         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([orgId, monthYear])
  @@index([orgId])
  @@map("payroll_runs")
}

model Payslip {
  id               String   @id @default(uuid())
  payrollRunId     String
  orgId            String
  employeeId       String
  employeeName     String
  employeeCode     String
  designation      String
  department       String
  bankName         String
  maskedAccount    String
  monthYear        String
  workingDays      Int      @default(30)
  daysPresent      Int      @default(28)
  paidLeaves       Int      @default(2)
  lossOfPayDays    Int      @default(0)
  basicSalary      Float    @default(0.0)
  hra              Float    @default(0.0)
  specialAllowance Float    @default(0.0)
  bonusOrIncentive Float    @default(0.0)
  grossEarnings    Float    @default(0.0)
  providentFund    Float    @default(0.0)
  esi              Float    @default(0.0)
  professionalTax  Float    @default(0.0)
  tdsIncomeTax     Float    @default(0.0)
  totalDeductions  Float    @default(0.0)
  netSalary        Float    @default(0.0)
  pdfFileKey       String?
  generatedDate    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payslips")
}

// -------------------------------------------------------------
// 7. PERFORMANCE & OKRS
// -------------------------------------------------------------

model PerformanceGoal {
  id              String   @id @default(uuid())
  orgId           String
  employeeId      String?
  employeeName    String
  department      String?
  title           String
  description     String?
  category        String   @default("OKR") // Individual, Team, Department, OKR
  targetMetric    String
  currentProgress Float    @default(0.0)
  weightage       Float    @default(25.0)
  startDate       String?
  dueDate         String
  priority        String   @default("Medium") // Low, Medium, High, Critical
  status          String   @default("On Track") // On Track, At Risk, Behind, Completed
  score           Float?   @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("performance_goals")
}

model PerformanceReview {
  id                  String   @id @default(uuid())
  orgId               String
  employeeId          String?
  employeeName        String
  reviewerName        String?
  cycle               String   @default("Q3 2026")
  reviewCycle         String   @default("Q3 2026")
  rating              Float?   @default(0.0)
  feedback            String?
  department          String?
  currentStage        String   @default("Self") // Self, Manager, Peer, HR, Final
  stage               String?
  isCompleted         Boolean  @default(false)
  selfRating          Float?   @default(0.0)
  selfComments        String?
  managerRating       Float?   @default(0.0)
  managerComments     String?
  managerStrengths    String?
  managerImprovements String?
  peerRating          Float?   @default(0.0)
  peerComments        String?
  hrRating            Float?   @default(0.0)
  hrComments          String?
  finalScore          Float?   @default(0.0)
  finalRecommendation String?  // Promote, Salary Revision, Retain & Train, Performance Plan, Exceeds Expectations
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("performance_reviews")
}

// -------------------------------------------------------------
// 8. RECRUITMENT & ATS
// -------------------------------------------------------------

model JobPosting {
  id             String   @id @default(uuid())
  orgId          String
  title          String
  department     String
  location       String
  employmentType String   @default("Full-Time")
  experience     String?
  salaryRange    String?
  description    String?
  skillsRequired Json?    // string[]
  qualifications String?
  hiringManager  String?
  status         String   @default("Published") // Published, Draft, Closed
  openings       Int      @default(1)
  appliedCount   Int      @default(0)
  postedDate     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidates   Candidate[]

  @@index([orgId])
  @@map("job_postings")
}

model Candidate {
  id               String   @id @default(uuid())
  orgId            String
  jobId            String?
  jobTitle         String
  name             String
  email            String
  phone            String
  currentCompany   String
  experienceYears  Float    @default(0.0)
  skills           Json?    // string[]
  expectedSalary   String?
  noticePeriodDays Int      @default(30)
  location         String?
  source           String   @default("LinkedIn")
  stage            String   @default("Screening") // Applied, Screening, Shortlisted, Technical, HR Round, Offer, Hired, Rejected
  resumeFileKey    String?
  resumeFileName   String?
  appliedDate      String
  rating           Float    @default(4.0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job          JobPosting?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  interviews   Interview[]

  @@index([orgId])
  @@index([jobId])
  @@map("candidates")
}

model Interview {
  id              String   @id @default(uuid())
  orgId           String
  candidateId     String?
  candidateName   String
  jobTitle        String?
  round           String?
  roundType       String   @default("Technical Round 1")
  interviewerName String
  scheduledAt     String?
  durationMinutes Int      @default(45)
  meetingLink     String?
  feedback        String?
  score           Float?   @default(0.0)
  status          String   @default("Scheduled") // Scheduled, Completed, Cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("interviews")
}

// -------------------------------------------------------------
// 9. EXPENSE MANAGEMENT
// -------------------------------------------------------------

model ExpenseClaim {
  id              String   @id @default(uuid())
  orgId           String
  employeeId      String
  employeeName    String
  category        String   // Travel, Meals, Software, Office Supplies, Medical, Other
  amount          Float
  currency        String   @default("INR")
  date            String   // "YYYY-MM-DD"
  merchant        String
  description     String
  receiptUrl      String?
  receiptFileKey  String?
  status          String   @default("Pending") // Pending, Approved, Rejected, Reimbursed
  approvedBy      String?
  approvedDate    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([employeeId])
  @@map("expense_claims")
}

// -------------------------------------------------------------
// 10. EMPLOYEE ENGAGEMENT
// -------------------------------------------------------------

model EngagementAnnouncement {
  id          String   @id @default(uuid())
  orgId       String
  title       String
  content     String
  category    String   @default("General") // General, Townhall, Milestone, Policy, Celebration
  authorName  String
  authorAvatar String?
  pinned      Boolean  @default(false)
  likesCount  Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("engagement_announcements")
}

model EngagementRecognition {
  id              String   @id @default(uuid())
  orgId           String
  senderId        String
  senderName      String
  senderAvatar    String?
  recipientId     String
  recipientName   String
  recipientAvatar String?
  badge           String   // Team Player, Innovation Hero, Customer Champion, Star Performer, Helping Hand
  message         String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("engagement_recognitions")
}

// -------------------------------------------------------------
// 11. MARKETPLACE & APP INTEGRATIONS
// -------------------------------------------------------------

model MarketplaceApp {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  category     String   // Communication, Productivity, Developer Tools, Compliance, Payments, Identity
  description  String
  developer    String
  icon         String
  badge        String?
  rating       Float    @default(4.8)
  reviewsCount Int      @default(0)
  pricing      String   @default("Free")
  isPopular    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  installations OrganizationMarketplaceApp[]

  @@map("marketplace_apps")
}

model OrganizationMarketplaceApp {
  id           String   @id @default(uuid())
  orgId        String
  appId        String
  installed    Boolean  @default(true)
  installedAt  DateTime @default(now())
  configuredBy String?

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  app          MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([orgId, appId])
  @@index([orgId])
  @@map("organization_marketplace_apps")
}

// -------------------------------------------------------------
// 12. NOTIFICATIONS & AUDIT TRAIL
// -------------------------------------------------------------

model NotificationItem {
  id        String   @id @default(uuid())
  orgId     String
  title     String
  message   String
  type      String   @default("system")
  timestamp String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("notifications")
}

model AuditLogEntry {
  id            String   @id @default(uuid())
  orgId         String
  timestamp     DateTime @default(now())
  userId        String?
  userName      String
  userRole      String
  action        String
  module        String
  recordName    String
  previousValue String?
  newValue      String?
  ipAddress     String   @default("127.0.0.1")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Insert-only table: no updates, no deletes allowed
  @@index([orgId])
  @@index([timestamp])
  @@map("audit_log_entries")
}

// -------------------------------------------------------------
// 13. FILE METADATA & SIGNED ACCESS
// -------------------------------------------------------------

model FileMetadata {
  id           String   @id @default(uuid())
  orgId        String
  fileKey      String   @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  category     String   // resume, payslip, document, policy
  uploadedById String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("file_metadata")
}
